{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wego-voice",
  "version": "0.1.2",
  "identifier": "com.wego.voice",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wego-voice",
        "width": 1160,
        "height": 800,
        "minWidth": 940,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$AUDIO/wego-voice/*"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}

